. 
. * Carrier technology type from carrier_id
. *   1 Alaska  2 American  3 Delta  4 Frontier  5 JetBlue  6 Southwest  7 Spirit  8 United
. gen byte LCC    = inlist(carrier_id, 5, 6)

. gen byte ULCC   = inlist(carrier_id, 4, 7)

